APP_PORT=8080
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# ⚠️ 这个密码必须与 docker-compose.yml 里的 MYSQL_ROOT_PASSWORD 一致，
#    否则容器起来了但后端连不上（/api/health 返回 db: down）。
#    用 docker compose 时无需修改；若用本机 MySQL，请改成你自己的密码。
DB_PASSWORD=lostfound123
DB_NAME=lost_found

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_HOURS=168

UPLOAD_DIR=uploads
UPLOAD_MAX_MB=2
PUBLIC_BASE_URL=http://localhost:8080
