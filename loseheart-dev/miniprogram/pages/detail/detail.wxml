<view class="page"><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{error}}" class="empty">{{error}}<button class="secondary" bindtap="load">重新查看</button></view><block wx:elif="{{post}}"><view class="panel detail-panel"><image wx:if="{{post.photos[0]}}" class="detail-cover" src="{{post.photos[0]}}" mode="aspectFit" data-url="{{post.photos[0]}}" bindtap="photo"/><view wx:else class="no-photo">{{post.image_urls.length?(post.photoErrors[0]?'图片加载失败':'图片加载中…'):'此帖子未上传照片'}}</view><button wx:if="{{post.image_urls.length&&!post.photos[0]}}" class="text-button" bindtap="retryPhotos">重试图片</button><view class="h1">{{post.item_name}}</view><view class="row"><text class="badge blue">{{post.post_type==='lost'?'寻物':'拾物'}}</text><text class="badge {{post.resolution_status}}">{{post.stateLabel}}</text><text wx:if="{{owner}}" class="badge {{post.review_status}}">{{post.reviewLabel}}</text></view><view class="fine">{{post.author.nickname}} · {{post.submittedLabel}}</view><view wx:if="{{post.review_reason}}" class="notice">审核说明：{{post.review_reason}}</view><view class="fact"><text>校区</text><text>{{post.campusLabel}}</text></view><view class="fact"><text>{{post.post_type==='lost'?'丢失地点':'拾获地点'}}</text><text>{{post.location}}</text></view><view class="fact"><text>{{post.post_type==='lost'?'丢失时间':'拾获时间'}}</text><text>{{post.timeLabel}}</text></view><view class="section-heading">物品描述</view><text class="preserve" selectable>{{post.description}}</text><view class="thumbs"><image wx:for="{{post.photos}}" wx:key="index" src="{{item}}" mode="aspectFill" data-url="{{item}}" data-index="{{index}}" bindtap="photo"/></view><view class="contact-box"><view class="h2">联系方式</view><view wx:for="{{post.contacts}}" wx:key="index" class="contact"><text selectable>{{item.label}}　{{item.value}}</text><button class="text-button" data-value="{{item.value}}" bindtap="copy">复制</button></view><view class="fine">请核实物品归属，再约定交接方式。</view></view><block wx:if="{{owner}}"><button class="list-link" bindtap="history">查看审核记录 <text>›</text></button><button wx:if="{{post.can_complete}}" class="primary" disabled="{{busy||conflict}}" bindtap="complete">{{post.resolution_status==='completed'?(post.post_type==='lost'?'恢复寻找中':'恢复待认领'):(post.post_type==='lost'?'标记已找回':'标记已归还')}}</button><view class="row"><button wx:if="{{post.can_edit}}" class="secondary grow" disabled="{{busy}}" bindtap="edit">编辑</button><button wx:if="{{post.resolution_status!=='withdrawn'}}" class="danger grow" disabled="{{busy||conflict}}" bindtap="withdraw">撤回</button></view><view wx:if="{{post.resolution_status==='withdrawn'}}" class="notice">已撤回：只读，无法编辑或恢复。</view></block><button wx:elif="{{post.can_report}}" class="text-button" disabled="{{reported}}" bindtap="report">{{reported?'举报已提交':'举报这条信息'}}</button><view wx:if="{{actionError&&!modal}}" class="error">{{actionError}}</view><button wx:if="{{conflict}}" class="secondary" bindtap="load">重新查看最新状态</button></view></block></view><view wx:if="{{modal==='report'}}" class="overlay"><view class="sheet"><view class="row between"><view class="h2">举报这条信息</view><button class="text-button" bindtap="close">关闭</button></view><picker range="{{reasonOptions}}" value="{{reasonIndex}}" bindchange="reason"><view class="picker">{{reasonOptions[reasonIndex]}} ▾</view></picker><view class="label">补充说明</view><textarea value="{{details}}" bindinput="details" maxlength="-1" placeholder="其他原因必填，最多 500 字"/><view class="fine">举报关联你正在查看的第 {{post.revision}} 版内容。</view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="sendReport">提交举报</button></view></view>
