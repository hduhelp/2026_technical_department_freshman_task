<view class="page"><view class="h1">{{forced?'设置新密码':'账号设置'}}</view><view wx:if="{{success}}" class="notice">{{success}}</view><view wx:if="{{!mode&&user}}" class="panel"><view class="fact"><text>昵称</text><text>{{user.nickname}}</text></view><view class="fact"><text>学号 / 职工号</text><text>{{user.account_no}}</text></view><view class="fact"><text>身份</text><text>{{user.identity_type==='student'?'学生':'教职工'}}</text></view><view class="fact"><text>验证状态</text><text>{{user.is_verified?'已验证':'未验证'}}</text></view><view class="fact"><text>微信</text><text>{{user.wechat_bound?'已绑定':'未绑定'}}</text></view><view class="fine">账号资料由平台维护。</view><button class="list-link" data-mode="password" bindtap="mode">修改密码 <text>›</text></button><button class="list-link" data-mode="binding" bindtap="mode">{{user.wechat_bound?'更换绑定微信':'绑定当前微信'}} <text>›</text></button><button class="danger" bindtap="exit">退出所有端登录</button></view><view wx:if="{{mode==='password'}}" class="panel"><view class="notice">{{forced?'请先修改临时密码后继续使用。':'修改密码后，所有端旧登录将失效。'}}</view><view class="label">当前密码</view><input password data-field="old" value="{{old}}" bindinput="input"/><view class="label">新密码</view><input password data-field="password" value="{{password}}" bindinput="input"/><view class="fine">8–32 个字符，不能与当前密码相同。</view><view class="label">确认新密码</view><input password data-field="confirm" value="{{confirm}}" bindinput="input"/><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="save">确认修改</button><button wx:if="{{!forced}}" class="secondary" disabled="{{busy}}" data-mode="" bindtap="mode">取消</button><button wx:else class="text-button" bindtap="exit">退出登录</button></view><view wx:if="{{mode==='binding'}}" class="panel"><view class="h2">{{user.wechat_bound?'更换绑定微信':'绑定当前微信'}}</view><view class="muted">绑定后可以使用当前微信快捷登录此平台账号。</view><view wx:if="{{user.wechat_bound}}"><view class="label">验证平台密码</view><input password data-field="bindingPassword" value="{{bindingPassword}}" bindinput="input"/><view class="notice">换绑成功后所有端旧登录失效。失败不会改变原绑定。</view></view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="bind">{{user.wechat_bound?'验证并换绑':'确认绑定'}}</button><button class="secondary" disabled="{{busy}}" data-mode="" bindtap="mode">取消</button></view><view wx:if="{{!user&&!forced&&!error}}" class="muted">正在加载账号资料…</view><view wx:if="{{error&&!mode}}" class="error">{{error}}</view><button wx:if="{{error&&!mode}}" class="secondary" bindtap="onShow">重新加载</button></view>
