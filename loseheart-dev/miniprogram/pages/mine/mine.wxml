<view class="page"><view class="profile panel"><view class="avatar">{{user.nickname[0]}}</view><view class="h1">{{user.nickname}}，你好</view><view class="muted">{{user.account_no}} · {{user.is_verified?'已验证':'未验证'}}</view><view class="quota">今日还可发布 <text>{{quota.remaining}}</text> 篇<view class="fine">北京时间零点恢复 · 编辑不占额度</view></view><button class="list-link" bindtap="notifications">我的通知 <text class="blue-text">{{unread?'未读 '+unread:'查看'}} ›</text></button><button class="list-link" bindtap="account">账号设置 <text>›</text></button></view><view class="section-heading">我的帖子</view><view class="two-col"><picker range="{{reviewOptions}}" value="{{reviewIndex}}" data-field="reviewIndex" bindchange="filter"><view class="picker">{{reviewOptions[reviewIndex]}} ▾</view></picker><picker range="{{resolutionOptions}}" value="{{resolutionIndex}}" data-field="resolutionIndex" bindchange="filter"><view class="picker">{{resolutionOptions[resolutionIndex]}} ▾</view></picker></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{!loading&&!records.length&&!error}}" class="empty">暂无相关帖子</view><view wx:for="{{records}}" wx:key="id" class="panel my-post" data-id="{{item.id}}" bindtap="detail"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/><view class="grow"><view class="h2">{{item.item_name}}</view><view class="row"><text class="badge {{item.review_status}}">{{item.reviewLabel}}</text><text class="badge">{{item.stateLabel}}</text></view><view class="fine">{{item.campusLabel}} · {{item.event_date}}</view><view wx:if="{{item.review_reason}}" class="fine">{{item.review_reason}}</view></view><text>›</text></view><view wx:if="{{loading}}" class="empty">正在加载…</view><button wx:if="{{records.length<total&&!loading}}" class="text-button" bindtap="more">加载更多</button></view>
