<view class="page"><view class="eyebrow">校园里的线索，在这里相遇</view><view class="hero-title"><view>你在寻找的，</view><view>也许就在这里。</view></view><view class="search"><input value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search" placeholder="搜索物品、地点或描述"/><button class="primary small" bindtap="search">搜索</button></view><view class="row between"><view class="segmented"><button class="{{post_type===''?'selected':''}}" data-value="" bindtap="type">全部</button><button class="{{post_type==='lost'?'selected':''}}" data-value="lost" bindtap="type">寻物</button><button class="{{post_type==='found'?'selected':''}}" data-value="found" bindtap="type">拾物</button></view><button class="text-button" bindtap="toggleFilter">筛选 ☰</button></view><view wx:if="{{filter}}" class="panel"><view class="label">校区</view><picker range="{{campuses}}" value="{{campusIndex}}" bindchange="campus"><view class="picker">{{campuses[campusIndex]}} ▾</view></picker><view class="label">状态</view><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="status"><view class="picker">{{statuses[statusIndex]}} ▾</view></picker><view class="two-col"><view><view class="label">开始日期</view><picker mode="date" value="{{event_date_from}}" data-field="event_date_from" bindchange="date"><view class="picker">{{event_date_from||'不限'}}</view></picker></view><view><view class="label">结束日期</view><picker mode="date" value="{{event_date_to}}" data-field="event_date_to" bindchange="date"><view class="picker">{{event_date_to||'不限'}}</view></picker></view></view><view class="row"><button class="secondary" bindtap="reset">重置</button><button class="primary" bindtap="apply">应用筛选</button></view></view><view class="section-heading">最新信息 <text class="fine">按首次发布时间排列</text></view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="search">重试</button></view><view wx:if="{{!loading&&!error&&!records.length}}" class="empty"><view>暂时没有相关信息</view><view>试试调整搜索和筛选条件</view></view><view class="post-card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill"/><view wx:else class="no-photo" data-id="{{item.id}}" catchtap="retryImage">{{item.cover_url?(item.coverError?'图片加载失败，点击重试':'图片加载中…'):'无图片'}}</view><view class="card-body"><view class="row between"><text class="badge blue">{{item.post_type==='lost'?'寻物':'拾物'}}</text><text class="badge {{item.resolution_status}}">{{item.stateLabel}}</text></view><view class="h2">{{item.item_name}}</view><view class="muted">{{item.campusLabel}} · {{item.location}}</view><view class="fine">{{item.timeLabel}}</view></view></view><view wx:if="{{loading}}" class="empty">正在加载…</view><button wx:if="{{!loading&&records.length<total}}" class="text-button" bindtap="more">加载更多</button></view>
