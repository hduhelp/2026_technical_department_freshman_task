<view class="page"><view class="h1">{{id?'编辑并重新提交':'发布一条信息'}}</view><view wx:if="{{success}}" class="panel success-panel"><view class="success-symbol">✓</view><view class="h1">已提交审核</view><view class="muted">审核结果会通过“我的通知”告诉你。</view><button class="primary" bindtap="view">查看帖子</button><button wx:if="{{!id}}" class="secondary" bindtap="another">继续发布</button></view><view wx:elif="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!ready}}" class="error">{{error}}<button class="secondary" bindtap="load">重新查看</button></view><block wx:else><view class="notice">{{id?'提交后暂时隐藏，审核通过后重新展示。':'今日还可发布 '+quota.remaining+' 篇，每天最多 3 篇。'}}</view><view class="panel"><view class="label">信息类型 *</view><view class="segmented"><button disabled="{{busy}}" class="{{form.post_type==='lost'?'selected':''}}" data-value="lost" bindtap="type">寻物</button><button disabled="{{busy}}" class="{{form.post_type==='found'?'selected':''}}" data-value="found" bindtap="type">拾物</button></view><view class="label">物品名称 *</view><input disabled="{{busy}}" value="{{form.item_name}}" data-field="item_name" bindinput="change" maxlength="-1" placeholder="例如：银色头戴式耳机"/><view class="fine">1–50 个字符</view><view class="label">校区 *</view><picker disabled="{{busy}}" data-field="campus" range="{{campuses}}" value="{{campusIndex}}" bindchange="campus"><view class="picker">{{campuses[campusIndex]}} ▾</view></picker><view class="label">{{form.post_type==='found'?'拾获地点':'丢失地点'}} *</view><input disabled="{{busy}}" value="{{form.location}}" data-field="location" bindinput="change" maxlength="-1" placeholder="具体到楼栋或区域，最多 100 字"/><view class="label">{{form.post_type==='found'?'拾获日期':'丢失日期'}} *</view><picker disabled="{{busy}}" mode="date" value="{{form.event_date}}" end="{{today}}" data-field="event_date" bindchange="change"><view class="picker">{{form.event_date}}</view></picker><view class="label">时间精度 *</view><picker disabled="{{busy}}" data-field="time_precision" range="{{precisions}}" value="{{precisionIndex}}" bindchange="precision"><view class="picker">{{precisions[precisionIndex]}} ▾</view></picker><view wx:if="{{form.time_precision!=='date'}}" class="two-col"><view><view class="label">{{form.time_precision==='range'?'开始时间':'具体时间'}}</view><picker disabled="{{busy}}" mode="time" value="{{form.event_time_start}}" data-field="event_time_start" bindchange="change"><view class="picker">{{form.event_time_start||'选择时间'}}</view></picker></view><view wx:if="{{form.time_precision==='range'}}"><view class="label">结束时间</view><picker disabled="{{busy}}" mode="time" value="{{form.event_time_end}}" data-field="event_time_end" bindchange="change"><view class="picker">{{form.event_time_end||'选择时间'}}</view></picker></view></view><view class="label">物品描述 *</view><textarea disabled="{{busy}}" value="{{form.description}}" data-field="description" bindinput="change" maxlength="-1" placeholder="颜色、外观、遗失或拾获经过等，最多 300 字" auto-height/><view class="label">物品照片 <text class="fine">选填，最多 6 张</text></view><view class="fine">JPEG / PNG，单张不超过 5 MB，首张为封面。</view><view class="photo-editor"><view wx:for="{{photos}}" wx:key="url" class="photo-tile"><image src="{{item.url}}" mode="aspectFill"/><view class="row"><button class="text-button small" data-index="{{index}}" data-direction="-1" disabled="{{busy||uploading||index===0}}" bindtap="movePhoto">←</button><button class="text-button small" data-index="{{index}}" disabled="{{busy||uploading}}" bindtap="removePhoto">移除</button><button class="text-button small" data-index="{{index}}" data-direction="1" disabled="{{busy||uploading||index===photos.length-1}}" bindtap="movePhoto">→</button></view><view wx:if="{{item.error}}" class="field-error">{{item.error}}<button class="text-button small" data-index="{{index}}" bindtap="retryPhoto">重试</button></view></view><button wx:if="{{photos.length<6}}" class="upload-tile" bindtap="choose" disabled="{{busy||uploading}}">{{uploading?'上传中…':'＋ 添加照片'}}</button></view><view class="label">联系方式 *</view><view class="fine">至少一项；同类型可以添加多条。</view><view wx:for="{{form.contact_methods}}" wx:key="index" class="contact-row"><picker disabled="{{busy}}" range="{{contactTypes}}" value="{{contactIndices[index]}}" data-index="{{index}}" bindchange="contactType"><view class="picker">{{contactLabels[index]}} ▾</view></picker><input disabled="{{busy}}" value="{{item.value}}" maxlength="-1" data-index="{{index}}" bindinput="contactInput" placeholder="填写联系方式"/><button class="text-button" disabled="{{busy}}" data-index="{{index}}" bindtap="removeContact">移除</button></view><button class="text-button" disabled="{{busy}}" bindtap="addContact">＋ 添加联系方式</button><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{conflict}}" class="secondary" bindtap="reload">重新查看最新版本</button><button class="primary" disabled="{{busy||uploading||conflict||(!id&&quota.remaining===0)}}" loading="{{busy}}" bindtap="submit">{{id?'提交重新审核':'提交审核'}}</button><view class="fine center">修改不占新帖额度，已完成状态保留。</view></view></block></view>
