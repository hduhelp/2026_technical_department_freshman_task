<view class="page"><view class="h1">我的通知</view><picker range="{{readOptions}}" value="{{readIndex}}" bindchange="filter"><view class="picker">{{readOptions[readIndex]}} ▾</view></picker><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{records}}" wx:key="id" class="panel"><view data-id="{{item.id}}" bindtap="open"><view class="h2"><text wx:if="{{!item.read_at}}" class="dot"></text>{{item.title}}</view><view class="fine">{{item.time}}　{{opened===item.id?'收起':'展开'}}</view></view><view wx:if="{{opened===item.id}}" class="notification-body"><text selectable>{{item.content}}</text><button wx:if="{{item.post_id}}" class="text-button" data-id="{{item.post_id}}" bindtap="post">查看相关帖子 →</button></view></view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:if="{{!loading&&!records.length}}" class="empty">暂无通知</view><button wx:if="{{records.length<total&&!loading}}" class="text-button" bindtap="more">加载更多</button></view>
