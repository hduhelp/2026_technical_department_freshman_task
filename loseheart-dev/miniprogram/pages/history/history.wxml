<view class="page"><view class="h1">审核记录</view><view class="fine">历史内容只读，不能修改或再次处理。</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{records}}" wx:key="id" class="panel"><view class="row between"><view class="h2">第 {{item.revision}} 版</view><text class="badge {{item.decision}}">{{item.label}}</text></view><view class="fine">{{item.time}} · {{item.reviewer.nickname||'暂无人工审核记录'}}</view><view wx:if="{{item.reason}}" class="notice">{{item.reason}}</view><view wx:if="{{item.decision==='superseded'}}" class="fine">内容更新后，旧待审记录已被取代。</view><button class="text-button" data-id="{{item.id}}" bindtap="open">{{opened===item.id?'收起快照':'查看历史快照 →'}}</button><view wx:if="{{opened===item.id}}"><view class="h2">{{item.snapshot.item_name}}</view><view class="muted">{{item.snapshot.campusLabel}} · {{item.snapshot.location}}</view><view class="fine">{{item.snapshot.timeLabel}}</view><text class="preserve" selectable>{{item.snapshot.description}}</text><view class="thumbs"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" bindtap="photo"/></view><view wx:for="{{item.snapshot.contacts}}" wx:for-item="contact" wx:key="index" class="contact"><text selectable>{{contact.label}}　{{contact.value}}</text><button class="text-button" data-value="{{contact.value}}" bindtap="copy">复制</button></view></view></view><view wx:if="{{loading}}" class="empty">正在加载…</view><button wx:if="{{records.length<total&&!loading}}" class="text-button" bindtap="more">加载更多</button></view>
