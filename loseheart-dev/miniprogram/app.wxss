page{background:#f5f5f7;color:#1d1d1f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}.page{padding:36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}.panel{background:#fff;border:1rpx solid #e6e6eb;border-radius:24rpx;padding:32rpx;margin:24rpx 0}.h1{font-size:44rpx;font-weight:600;line-height:1.35;margin:12rpx 0 26rpx;letter-spacing:-1rpx}.h2{font-size:32rpx;font-weight:600;margin:16rpx 0}.hero-title{font-size:54rpx;font-weight:650;line-height:1.35;letter-spacing:-2rpx;margin:16rpx 0 32rpx}.eyebrow{font-size:20rpx;color:#6e6e73;letter-spacing:3rpx;margin-top:16rpx}.muted{color:#6e6e73;font-size:26rpx;line-height:1.8}.fine{font-size:22rpx;color:#73737a;line-height:1.7;margin:10rpx 0}.center{text-align:center}.row{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}.grow{flex:1;min-width:0}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.primary,.secondary,.danger{font-size:28rpx;font-weight:500;min-height:88rpx;line-height:1.4;padding:24rpx 28rpx;border-radius:16rpx;margin:20rpx 0 10rpx;text-align:center}.primary{background:#0066cc;color:#fff}.secondary{background:#fff;color:#0066cc;border:1rpx solid #cdd4df}.danger{background:#fff1f1;color:#bd2937;border:1rpx solid #efc4c9}button::after{border:0}button[disabled]{opacity:.5}button:active{opacity:.8}.text-button{border:0;background:transparent;color:#0066cc;font-size:26rpx;padding:14rpx 0;margin:0;line-height:1.7;min-height:72rpx}.small{font-size:24rpx;padding:16rpx 24rpx;min-height:70rpx;white-space:nowrap}.label{font-size:26rpx;font-weight:500;margin:28rpx 0 12rpx}input,.picker,textarea{border:1rpx solid #d7d7df;border-radius:14rpx;background:#fff;padding:20rpx 24rpx;font-size:28rpx;width:100%;min-height:88rpx}input{height:88rpx}textarea{min-height:200rpx;line-height:1.7;padding:24rpx}.picker{margin:10rpx 0}.error,.notice{border-radius:14rpx;padding:24rpx;font-size:26rpx;margin:24rpx 0;line-height:1.7}.error{background:#fff0f1;color:#b02837}.notice{background:#edf5ff;color:#285d94}.field-error{color:#b02837;font-size:22rpx}.segmented{display:flex;background:#ececf1;padding:6rpx;border-radius:14rpx;gap:4rpx;margin:18rpx 0}.segmented button{flex:1;background:transparent;border:0;font-size:26rpx;line-height:1.5;padding:14rpx 26rpx;color:#6e6e73;border-radius:10rpx;margin:0}.segmented .selected{background:white;color:#0066cc;box-shadow:0 2rpx 5rpx #00000008}.search{display:flex;gap:16rpx}.search input{flex:1}.search button{margin:0}.section-heading{font-size:32rpx;font-weight:600;display:flex;justify-content:space-between;align-items:center;margin:32rpx 0 20rpx}.section-heading .fine{font-weight:400;font-size:20rpx}.post-card{background:white;border:1rpx solid #e6e6eb;border-radius:24rpx;overflow:hidden;margin-bottom:28rpx}.cover{width:100%;height:360rpx;display:block}.no-photo{height:220rpx;display:flex;align-items:center;justify-content:center;background:#eeeef2;color:#87878e;font-size:24rpx;border-radius:16rpx}.card-body{padding:28rpx}.badge{display:inline-block;border-radius:10rpx;padding:5rpx 14rpx;background:#eeeef2;color:#64646b;font-size:22rpx;font-weight:500;line-height:1.7}.badge.blue,.badge.active{background:#eaf3ff;color:#0066cc}.badge.approved,.badge.completed{background:#ebf7ef;color:#287f42}.badge.pending{background:#fff2df;color:#93620f}.badge.returned,.badge.rejected,.badge.removed{background:#fff0f1;color:#af2c39}.blue-text{color:#0066cc}.empty{text-align:center;color:#6e6e73;padding:80rpx 24rpx;line-height:2}.login-page{padding-top:76rpx}.login-page .intro{margin-bottom:48rpx}.login-page .panel{margin-top:36rpx}.profile .avatar{width:96rpx;height:96rpx;border-radius:50%;background:#e7f1ff;color:#0066cc;font-size:40rpx;text-align:center;line-height:96rpx;margin-bottom:20rpx}.quota{background:#f7f9fc;border-radius:16rpx;padding:20rpx 24rpx;margin:26rpx 0;font-size:26rpx}.quota>text{font-size:40rpx;color:#0066cc;margin:0 8rpx}.list-link{width:100%;background:white;padding:28rpx 0;margin:0;display:flex;justify-content:space-between;border-top:1rpx solid #ededf1;border-radius:0;text-align:left;font-size:28rpx;line-height:1.5}.my-post{display:flex;gap:22rpx;align-items:center;padding:24rpx}.my-post>image{width:130rpx;height:150rpx;border-radius:14rpx}.my-post .h2{font-size:30rpx;margin:0 0 12rpx}.fact{display:flex;justify-content:space-between;gap:30rpx;padding:18rpx 0;font-size:26rpx}.fact>text:first-child{color:#6e6e73;min-width:140rpx}.fact>text:last-child{text-align:right;word-break:break-all}.detail-cover{width:100%;height:440rpx;border-radius:18rpx;background:#f4f4f6}.detail-panel>.fine{margin:20rpx 0}.preserve{white-space:pre-wrap;font-size:28rpx;line-height:1.8;display:block;margin:20rpx 0;word-break:break-all}.thumbs{display:flex;gap:16rpx;flex-wrap:wrap;margin:24rpx 0}.thumbs image{width:164rpx;height:144rpx;border-radius:14rpx;background:#eeeef2}.contact-box{background:#f7f8fb;border-radius:18rpx;padding:24rpx;margin:28rpx 0}.contact{display:flex;justify-content:space-between;gap:20rpx;align-items:center;font-size:26rpx}.contact>text{word-break:break-all}.contact button{flex-shrink:0}.overlay{position:fixed;inset:0;background:#15223280;z-index:50;display:flex;align-items:flex-end}.sheet{background:white;width:100%;padding:36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;max-height:90vh;overflow:auto}.sheet .h2{margin:0}.photo-editor{display:flex;gap:20rpx;flex-wrap:wrap;margin:20rpx 0}.photo-tile{width:180rpx}.photo-tile image{width:180rpx;height:160rpx;border-radius:14rpx}.photo-tile .row{gap:4rpx;justify-content:space-between}.photo-tile .small{padding:8rpx 0;min-height:50rpx;font-size:22rpx}.upload-tile{width:180rpx;height:160rpx;border:1rpx dashed #c2cbd7;background:#fafbfc;color:#6e6e73;font-size:24rpx;line-height:160rpx;padding:0;margin:0;border-radius:14rpx}.contact-row{display:flex;gap:12rpx;align-items:center;margin:16rpx 0}.contact-row picker{width:150rpx;flex-shrink:0}.contact-row .picker{padding:20rpx 12rpx;font-size:24rpx;margin:0}.contact-row input{flex:1;min-width:0;padding:20rpx 14rpx;font-size:24rpx}.contact-row .text-button{font-size:22rpx;flex-shrink:0}.success-panel{text-align:center;padding:60rpx 32rpx}.success-symbol{font-size:58rpx;color:#278548;border-radius:50%;background:#e8f6ed;width:120rpx;height:120rpx;line-height:120rpx;margin:0 auto 28rpx}.notification-body{padding-top:24rpx;white-space:pre-wrap;font-size:28rpx}.dot{display:inline-block;width:12rpx;height:12rpx;background:#0066cc;border-radius:50%;margin-right:14rpx}

.login-page .primary,.login-page .secondary{width:100%}

.search input{min-width:0}.search button{width:120rpx;flex-shrink:0}.row.between>.segmented{flex:1;min-width:0}.row.between>.text-button{width:auto;flex-shrink:0;white-space:nowrap}.segmented button{width:auto;min-width:0;padding:14rpx 18rpx;white-space:nowrap}

